# Copy this file to .env and fill in real values. Never commit .env itself.

# --- App ---
APP_ENV=development
APP_PORT=8000

# --- Segmentation ---
# Options considered: rembg (local, free), SAM (local, heavier)
SEGMENTATION_BACKEND=rembg

# --- Scene generation (backend undecided per PRD, fill in whichever you're benchmarking) ---
# Options: mock, replicate, fal, stability
SCENE_GEN_PROVIDER=mock
SCENE_GEN_API_KEY=
# Model overrides (optional):
#   replicate: black-forest-labs/flux-schnell, stability-ai/sdxl
#   fal: fal-ai/flux/schnell, fal-ai/fast-sdxl
#   stability: stable-image/generate/core, stable-image/generate/sd3
SCENE_GEN_MODEL=

# --- Storage ---
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# --- Rate limiting (per rules.md: required even in v1) ---
MAX_GENERATIONS_PER_SESSION_PER_HOUR=10
